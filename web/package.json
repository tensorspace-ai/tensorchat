{
  "name": "tensorchat-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TensorChat web client — no framework, no runtime dependencies.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tensorspace-ai/tensorchat.git",
    "directory": "web"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch",
    "test": "node --test test/msgpack.test.mjs test/notify.test.mjs test/signals.test.mjs test/virtual-list.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
